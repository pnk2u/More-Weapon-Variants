{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "pnku"
  ],
  "contact": {
    "homepage": "https://www.pnku.de",
    "email": "contact@pnku.de",
    "sources": "https://github.com/pnk2u/More-Weapon-Variants",
    "issues": "https://github.com/pnk2u/More-Weapon-Variants/issues"
  },
  "license": "${mod_license}",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "de.pnku.mstv_mweaponv.MoreWeaponVariants"
    ],
    "client": [
      "de.pnku.mstv_mweaponv.MoreWeaponVariantsClient"
    ]
  },
  "accessWidener": "mstv-mweaponv.accesswidener",
  "mixins": [
    "mstv-mweaponv.mixins.json",
    "mstv-mweaponv.mtoolv.mixins.json",
    {
      "config": "mstv-mweaponv.client.mixins.json",
      "environment": "client"
    },
    {
      "config": "mstv-mweaponv.client.compat.nea.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": [">${minecraft_version_0} <${minecraft_version_1}"],
    "java": ">=17",
    "fabric-api": "*",
    "mstv-base": ">=${mstv_version}"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.lieonlion.dev"
      }
    },
    "mc-publish": {
      "modrinth": "TAu3MvxJ",
      "curseforge": "1133775",
      "dependencies": [
        "fabric-api(required)#(ignore)",
        "mstv-base(required){modrinth:ZVv4e6pP}{curseforge:1096913}"
      ]
    }
  }
}